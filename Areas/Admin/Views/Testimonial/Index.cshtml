@model List<LifeSure.Mediator.Testimonials.Results.TestimonialResult>

@{
    ViewData["Title"] = "Referanslar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0">Referanslar</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>
        Yeni Referans
    </a>
</div>

<div class="admin-card p-4">
    @if (Model.Count == 0)
    {
        <div class="alert alert-info mb-0">
            Henüz referans eklenmedi.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Fotoğraf</th>
                        <th>Ad soyad</th>
                        <th>Unvan</th>
                        <th>Puan</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var title = item.Translations
                            .FirstOrDefault(x => x.LanguageCode == "tr")
                            ?.Title;

                        <tr>
                            <td>
                                <img src="@item.ImageUrl"
                                     alt="@item.FullName"
                                     class="rounded-circle"
                                     style="width: 56px; height: 56px; object-fit: cover;" />
                            </td>
                            <td>@item.FullName</td>
                            <td>@title</td>
                            <td>
                                <span class="text-warning">
                                    <i class="fas fa-star"
                                       aria-hidden="true"></i>
                                </span>
                                @item.Rating / 5
                            </td>
                            <td>@item.DisplayOrder</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Düzenle
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Bu referansı silmek istediğinize emin misiniz?');">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>