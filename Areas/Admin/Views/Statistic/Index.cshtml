@using LifeSure.Enums
@model List<LifeSure.CQRS.Statistics.Results.StatisticResult>

@{
    ViewData["Title"] = "İstatistikler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0">İstatistikler</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>
        Yeni İstatistik
    </a>
</div>

<div class="admin-card p-4">
    <p class="text-muted">
        Otomatik kaynakların değerleri aktif kayıtlardan hesaplanır.
    </p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info mb-0">
            Henüz istatistik eklenmedi.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Kaynak</th>
                        <th>Görünen değer</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var title = item.Translations
                            .FirstOrDefault(x => x.LanguageCode == "tr")
                            ?.Title;

                        var sourceText = item.Source switch
                        {
                            StatisticSource.Manual => "Manuel",
                            StatisticSource.ActiveTeamMemberCount =>
                                "Aktif ekip üyeleri",
                            StatisticSource.ActiveServiceCount =>
                                "Aktif hizmetler",
                            _ => "Bilinmeyen"
                        };

                        <tr>
                            <td>@title</td>
                            <td>@sourceText</td>
                            <td>@item.DisplayValue@item.Suffix</td>
                            <td>@item.DisplayOrder</td>
                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Düzenle
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Bu istatistiği silmek istediğinize emin misiniz?');">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>