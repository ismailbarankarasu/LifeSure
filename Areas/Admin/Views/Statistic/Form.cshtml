@model LifeSure.Areas.Admin.Models.StatisticFormViewModel

<div class="admin-card p-4">
    <form asp-action="Save"
          asp-route-id="@Model.Id"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="Source" class="form-label"></label>

                <select asp-for="Source" class="form-select">
                    <option value="0">Manuel değer</option>
                    <option value="1">Aktif ekip üyesi sayısı</option>
                    <option value="2">Aktif hizmet sayısı</option>
                </select>

                <span asp-validation-for="Source"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Value" class="form-label"></label>

                <input asp-for="Value"
                       type="number"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="Value"
                      class="text-danger"></span>

                <div class="form-text">
                    Yalnızca “Manuel değer” seçildiğinde kullanılır.
                    Otomatik kaynaklarda sayı veritabanından hesaplanır.
                </div>
            </div>

            <div class="col-md-6">
                <label asp-for="Suffix" class="form-label"></label>

                <input asp-for="Suffix"
                       class="form-control"
                       placeholder="Örneğin: +" />

                <span asp-validation-for="Suffix"
                      class="text-danger"></span>

                <div class="form-text">
                    İsteğe bağlıdır. Örneğin 10 sayısına + eklenirse 10+ görünür.
                </div>
            </div>

            <div class="col-md-6">
                <label asp-for="DisplayOrder" class="form-label"></label>

                <input asp-for="DisplayOrder"
                       type="number"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="DisplayOrder"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="TurkishTitle" class="form-label"></label>

                <input asp-for="TurkishTitle" class="form-control" />

                <span asp-validation-for="TurkishTitle"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="EnglishTitle" class="form-label"></label>

                <input asp-for="EnglishTitle" class="form-control" />

                <span asp-validation-for="EnglishTitle"
                      class="text-danger"></span>

                <div class="form-text">
                    Boş bırakılırsa sitede Türkçe başlık gösterilir.
                </div>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label"></label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Kaydet
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Listeye Dön
                </a>
            </div>
        </div>
    </form>
</div>