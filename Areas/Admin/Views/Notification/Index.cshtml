@model LifeSure.Mediator.Notifications.Results.NotificationListResult

@{
    ViewData["Title"] = "Bildirimler";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="h4 mb-1">Bildirimler</h2>

        <p class="text-muted mb-0">
            @Model.UnreadCount okunmamış bildirim
        </p>
    </div>

    @if (Model.UnreadCount > 0)
    {
        <form asp-action="MarkAllAsRead"
              method="post"
              onsubmit="return confirm('Tüm okunmamış bildirimleri okundu olarak işaretlemek istiyor musunuz?');">

            <input type="hidden"
                   name="onlyUnread"
                   value="@Model.OnlyUnread.ToString().ToLowerInvariant()" />

            <button type="submit" class="btn btn-outline-primary">
                <i class="fas fa-check-double me-2"
                   aria-hidden="true"></i>
                Tümünü Okundu Yap
            </button>
        </form>
    }
</div>

<div class="d-flex flex-wrap gap-2 mb-4">
    <a asp-action="Index"
       class="btn @(Model.OnlyUnread ? "btn-outline-primary" : "btn-primary")">
        Tümü
    </a>

    <a asp-action="Index"
       asp-route-onlyUnread="true"
       class="btn @(Model.OnlyUnread ? "btn-primary" : "btn-outline-primary")">
        Okunmamış
        <span class="badge bg-light text-primary ms-1">
            @Model.UnreadCount
        </span>
    </a>
</div>

<div class="admin-card p-4">
    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5">
            <i class="far fa-bell fa-3x text-muted mb-3"
               aria-hidden="true"></i>

            <h3 class="h5">
                @(Model.OnlyUnread
                    ? "Okunmamış bildiriminiz yok."
                    : "Henüz bildirim bulunmuyor.")
            </h3>

            <p class="text-muted mb-0">
                Yeni iletişim mesajları geldiğinde burada görebilirsiniz.
            </p>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model.Items)
            {
                <article class="admin-notification-item @(item.IsRead ? "" : "is-unread")">
                    <div class="admin-notification-icon">
                        <i class="@(item.IsRead ? "far fa-envelope-open" : "fas fa-envelope")"
                           aria-hidden="true"></i>
                    </div>

                    <div class="admin-notification-content">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <h3 class="h6 mb-0">@item.Title</h3>

                            @if (!item.IsRead)
                            {
                                <span class="badge bg-primary">Yeni</span>
                            }
                        </div>

                        <p class="text-muted mb-2">
                            @item.Description
                        </p>

                        <div class="small text-muted">
                            @(item.CreatedAt.ToString("dd.MM.yyyy HH:mm")) UTC

                            @if (item.ReadAt.HasValue)
                            {
                                <span class="d-block">
                                    Okunma:
                                    @(item.ReadAt.Value.ToString("dd.MM.yyyy HH:mm")) UTC
                                </span>
                            }
                        </div>
                    </div>

                    <form asp-action="Open"
                          asp-route-id="@item.Id"
                          method="post"
                          class="admin-notification-action">

                        <button type="submit"
                                class="btn btn-sm btn-outline-primary">
                            Mesaja Git
                            <i class="fas fa-arrow-right ms-1"
                               aria-hidden="true"></i>
                        </button>
                    </form>
                </article>
            }
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <span class="text-muted small">
                @Model.TotalCount kayıt ·
                Sayfa @Model.Page / @Model.TotalPages
            </span>

            <div class="d-flex gap-2">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-onlyUnread="@Model.OnlyUnread"
                       class="btn btn-sm btn-outline-secondary">
                        Önceki
                    </a>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-onlyUnread="@Model.OnlyUnread"
                       class="btn btn-sm btn-outline-secondary">
                        Sonraki
                    </a>
                }
            </div>
        </div>
    }
</div>