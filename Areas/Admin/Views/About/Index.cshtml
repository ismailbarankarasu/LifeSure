@model List<LifeSure.CQRS.Abouts.Results.AboutResult>

@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <h2 class="h5 mb-0">Hakkımızda İçerikleri</h2>

        <a asp-action="Create" class="btn btn-primary">
            Yeni İçerik
        </a>
    </div>

    <p class="small text-muted">
        Ana sayfada yayındaki içeriklerden gösterim sırası en küçük
        olan kayıt gösterilir. Sıra eşitse önce eklenen kayıt kullanılır.
    </p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info mb-0">
            Henüz hakkımızda içeriği eklenmemiş.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Görsel</th>
                        <th>Başlık</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var about in Model)
                    {
                        var translation = about.Translations
                            .FirstOrDefault(x => x.LanguageCode == "tr");

                        <tr>
                            <td>
                                <img src="@about.ImageUrl"
                                     alt="@(translation?.Title ?? "Hakkımızda görseli")"
                                     width="90"
                                     height="65"
                                     class="rounded"
                                     style="object-fit: cover;" />
                            </td>

                            <td>@translation?.Title</td>
                            <td>@about.DisplayOrder</td>

                            <td>
                                <span class="badge @(about.IsActive ? "bg-success" : "bg-secondary")">
                                    @(about.IsActive ? "Yayında" : "Pasif")
                                </span>
                            </td>

                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@about.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Düzenle
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@about.Id"
                                          method="post"
                                          onsubmit="return confirm('Bu içerik silinsin mi?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Sil
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>