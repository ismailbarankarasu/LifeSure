@using LifeSure.Enums
@model LifeSure.Mediator.ContactMessages.Results.ContactMessageListResult

@{
    ViewData["Title"] = "İletişim Mesajları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0">İletişim Mesajları</h2>
    <span class="badge bg-primary">@Model.TotalCount mesaj</span>
</div>

<div class="admin-card p-4">
    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info mb-0">
            Henüz iletişim mesajı gelmedi.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Gönderen</th>
                        <th>Konu</th>
                        <th>Tarih (UTC)</th>
                        <th>Durum</th>
                        <th class="text-end">İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var statusText = item.Status switch
                        {
                            ContactMessageStatus.New => "Yeni",
                            ContactMessageStatus.Read => "Okundu",
                            ContactMessageStatus.Replied => "Yanıtlandı",
                            _ => "Bilinmeyen"
                        };

                        var badgeClass = item.Status switch
                        {
                            ContactMessageStatus.New => "bg-primary",
                            ContactMessageStatus.Read => "bg-secondary",
                            ContactMessageStatus.Replied => "bg-success",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>@item.FullName</td>
                            <td style="max-width: 350px; overflow-wrap: anywhere;">
                                @item.Subject
                            </td>
                            <td class="text-nowrap">
                                @(item.CreatedAt.ToString("dd.MM.yyyy HH:mm"))
                            </td>
                            <td>
                                <span class="badge @badgeClass">
                                    @statusText
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Görüntüle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <span class="text-muted">
                Sayfa @Model.Page / @Model.TotalPages
            </span>

            <div class="d-flex gap-2">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.Page - 1)"
                       class="btn btn-outline-secondary btn-sm">
                        Önceki
                    </a>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.Page + 1)"
                       class="btn btn-outline-secondary btn-sm">
                        Sonraki
                    </a>
                }
            </div>
        </div>
    }
</div>