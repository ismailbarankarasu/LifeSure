@model LifeSure.Areas.Admin.Models.FaqFormViewModel

<form asp-action="Save"
      asp-route-id="@Model.Id"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <div class="admin-card p-4 mb-4">
        <h3 class="h5 mb-4">Genel Bilgiler</h3>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="DisplayOrder" class="form-label"></label>

                <input asp-for="DisplayOrder"
                       type="number"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="DisplayOrder"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check mt-3">
                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="admin-card p-4 h-100">
                <h3 class="h5 mb-4">Türkçe İçerik</h3>

                <div class="mb-3">
                    <label asp-for="TurkishQuestion"
                           class="form-label"></label>

                    <textarea asp-for="TurkishQuestion"
                              rows="3"
                              class="form-control"></textarea>

                    <span asp-validation-for="TurkishQuestion"
                          class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="TurkishAnswer"
                           class="form-label"></label>

                    <textarea asp-for="TurkishAnswer"
                              rows="8"
                              class="form-control"></textarea>

                    <span asp-validation-for="TurkishAnswer"
                          class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="admin-card p-4 h-100">
                <h3 class="h5 mb-2">İngilizce İçerik</h3>

                <p class="text-muted small">
                    İsteğe bağlıdır. Çeviri eklemek için iki alanı da doldurun.
                    İkisini de temizlerseniz mevcut İngilizce çeviri kaldırılır.
                </p>

                <div class="mb-3">
                    <label asp-for="EnglishQuestion"
                           class="form-label"></label>

                    <textarea asp-for="EnglishQuestion"
                              rows="3"
                              class="form-control"></textarea>

                    <span asp-validation-for="EnglishQuestion"
                          class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="EnglishAnswer"
                           class="form-label"></label>

                    <textarea asp-for="EnglishAnswer"
                              rows="8"
                              class="form-control"></textarea>

                    <span asp-validation-for="EnglishAnswer"
                          class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            Kaydet
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Listeye Dön
        </a>
    </div>
</form>