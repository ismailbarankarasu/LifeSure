@model List<LifeSure.CQRS.Features.Results.FeatureResult>

@{
    ViewData["Title"] = "Özellikler";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <h2 class="h5 mb-0">Özellik Listesi</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1" aria-hidden="true"></i>
            Yeni Özellik
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info mb-0">
            Henüz özellik eklenmemiş.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>İkon</th>
                        <th>Başlık</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var feature in Model)
                    {
                        var translation = feature.Translations
                            .FirstOrDefault(x => x.LanguageCode == "tr");

                        <tr>
                            <td>
                                <i class="@feature.IconClass fa-2x text-primary"
                                   aria-hidden="true"></i>
                            </td>

                            <td>@(translation?.Title ?? "Başlıksız")</td>
                            <td>@feature.DisplayOrder</td>

                            <td>
                                <span class="badge @(feature.IsActive ? "bg-success" : "bg-secondary")">
                                    @(feature.IsActive ? "Yayında" : "Pasif")
                                </span>
                            </td>

                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@feature.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Düzenle
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@feature.Id"
                                          method="post"
                                          onsubmit="return confirm('Bu özellik silinsin mi?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Sil
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>