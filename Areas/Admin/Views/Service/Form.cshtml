@model LifeSure.Areas.Admin.Models.ServiceFormViewModel

<form asp-action="Save"
      asp-route-id="@Model.Id"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <div class="admin-card p-4 mb-4">
        <h3 class="h5 mb-4">Genel Bilgiler</h3>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="ImageFile" class="form-label"></label>

                <input asp-for="ImageFile"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp"
                       class="form-control" />

                <span asp-validation-for="ImageFile"
                      class="text-danger"></span>

                <div class="form-text">
                    JPG, PNG veya WebP. En fazla 5 MB.
                    Düzenleme sırasında boş bırakırsanız mevcut görsel korunur.
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
                {
                    <img src="@Model.ExistingImageUrl"
                         alt="Mevcut hizmet görseli"
                         class="img-fluid rounded mt-3"
                         style="max-height: 180px;" />
                }
            </div>

            <div class="col-md-6">
                <label asp-for="IconClass" class="form-label"></label>

                <input asp-for="IconClass" class="form-control" />

                <span asp-validation-for="IconClass"
                      class="text-danger"></span>

                <div class="form-text">
                    Örnek: fas fa-heart, fas fa-car, fas fa-home
                </div>
            </div>

            <div class="col-md-6">
                <label asp-for="DisplayOrder" class="form-label"></label>

                <input asp-for="DisplayOrder"
                       type="number"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="DisplayOrder"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check mt-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="admin-card p-4 h-100">
                <h3 class="h5 mb-4">Türkçe İçerik</h3>

                <div class="mb-3">
                    <label asp-for="TurkishTitle" class="form-label"></label>
                    <input asp-for="TurkishTitle" class="form-control" />
                    <span asp-validation-for="TurkishTitle"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TurkishShortDescription"
                           class="form-label"></label>
                    <textarea asp-for="TurkishShortDescription"
                              rows="3"
                              class="form-control"></textarea>
                    <span asp-validation-for="TurkishShortDescription"
                          class="text-danger"></span>
                    <div class="form-text">
                        Ana sayfadaki hizmet kartında gösterilir.
                    </div>
                </div>

                <div>
                    <label asp-for="TurkishDescription"
                           class="form-label"></label>
                    <textarea asp-for="TurkishDescription"
                              rows="8"
                              class="form-control"></textarea>
                    <span asp-validation-for="TurkishDescription"
                          class="text-danger"></span>
                    <div class="form-text">
                        Devamını Oku penceresinde gösterilir.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="admin-card p-4 h-100">
                <h3 class="h5 mb-2">İngilizce İçerik</h3>

                <p class="text-muted small">
                    İsteğe bağlıdır. Yeni bir çeviri eklerken üç alanı da doldurun.
                    Düzenlemede tümünü boş bırakmak mevcut İngilizce çeviriyi korur.
                </p>

                <div class="mb-3">
                    <label asp-for="EnglishTitle" class="form-label"></label>
                    <input asp-for="EnglishTitle" class="form-control" />
                    <span asp-validation-for="EnglishTitle"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EnglishShortDescription"
                           class="form-label"></label>
                    <textarea asp-for="EnglishShortDescription"
                              rows="3"
                              class="form-control"></textarea>
                    <span asp-validation-for="EnglishShortDescription"
                          class="text-danger"></span>
                </div>

                <div>
                    <label asp-for="EnglishDescription"
                           class="form-label"></label>
                    <textarea asp-for="EnglishDescription"
                              rows="8"
                              class="form-control"></textarea>
                    <span asp-validation-for="EnglishDescription"
                          class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            Kaydet
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Listeye Dön
        </a>
    </div>
</form>