@model List<LifeSure.Mediator.TeamMembers.Results.TeamMemberResult>

@{
    ViewData["Title"] = "Ekip Üyeleri";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0">Ekip Üyeleri</h2>

    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>
        Yeni Ekip Üyesi
    </a>
</div>

<div class="admin-card p-4">
    @if (Model.Count == 0)
    {
        <div class="alert alert-info mb-0">
            Henüz ekip üyesi eklenmedi.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Fotoğraf</th>
                        <th>Ad soyad</th>
                        <th>Görev</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var member in Model)
                    {
                        var jobTitle = member.Translations
                            .FirstOrDefault(x => x.LanguageCode == "tr")
                            ?.JobTitle;

                        <tr>
                            <td>
                                <img src="@member.ImageUrl"
                                     alt="@member.FullName"
                                     class="rounded"
                                     style="width: 64px; height: 64px; object-fit: cover;" />
                            </td>
                            <td>@member.FullName</td>
                            <td>@jobTitle</td>
                            <td>@member.DisplayOrder</td>
                            <td>
                                <span class="badge @(member.IsActive ? "bg-success" : "bg-secondary")">
                                    @(member.IsActive ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit"
                                   asp-route-id="@member.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Düzenle
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@member.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Bu ekip üyesini silmek istediğinize emin misiniz?');">
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>