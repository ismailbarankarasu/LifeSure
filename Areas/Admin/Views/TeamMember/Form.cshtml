@model LifeSure.Areas.Admin.Models.TeamMemberFormViewModel

<form asp-action="Save"
      asp-route-id="@Model.Id"
      method="post"
      enctype="multipart/form-data">

    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <div class="admin-card p-4 mb-4">
        <h3 class="h5 mb-4">Üye Bilgileri</h3>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ImageFile" class="form-label"></label>

                <input asp-for="ImageFile"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp"
                       class="form-control" />

                <span asp-validation-for="ImageFile"
                      class="text-danger"></span>

                <div class="form-text">
                    JPG, PNG veya WebP. En fazla 5 MB.
                    Düzenlerken boş bırakırsanız mevcut fotoğraf korunur.
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ExistingImageUrl))
                {
                    <img src="@Model.ExistingImageUrl"
                         alt="Mevcut ekip üyesi fotoğrafı"
                         class="rounded mt-3"
                         style="width: 140px; height: 160px; object-fit: cover;" />
                }
            </div>

            <div class="col-md-6">
                <label asp-for="TurkishJobTitle" class="form-label"></label>
                <input asp-for="TurkishJobTitle" class="form-control" />
                <span asp-validation-for="TurkishJobTitle"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="EnglishJobTitle" class="form-label"></label>
                <input asp-for="EnglishJobTitle" class="form-control" />
                <span asp-validation-for="EnglishJobTitle"
                      class="text-danger"></span>

                <div class="form-text">
                    İsteğe bağlıdır. Boş bırakıldığında Türkçe görev gösterilir.
                    Mevcut İngilizce metni temizlemek çeviriyi kaldırır.
                </div>
            </div>

            <div class="col-md-6">
                <label asp-for="DisplayOrder" class="form-label"></label>

                <input asp-for="DisplayOrder"
                       type="number"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="DisplayOrder"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6 d-flex align-items-center">
                <div class="form-check mt-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-card p-4 mb-4">
        <h3 class="h5 mb-2">Sosyal Medya Bağlantıları</h3>

        <p class="text-muted small mb-4">
            Alanlar isteğe bağlıdır. Tam bağlantı giriniz.
            Boş bırakılan hesapların ikonları sitede gösterilmez.
        </p>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="FacebookUrl" class="form-label"></label>

                <input asp-for="FacebookUrl"
                       class="form-control"
                       placeholder="https://www.facebook.com/..." />

                <span asp-validation-for="FacebookUrl"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="InstagramUrl" class="form-label"></label>

                <input asp-for="InstagramUrl"
                       class="form-control"
                       placeholder="https://www.instagram.com/..." />

                <span asp-validation-for="InstagramUrl"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LinkedInUrl" class="form-label"></label>

                <input asp-for="LinkedInUrl"
                       class="form-control"
                       placeholder="https://www.linkedin.com/in/..." />

                <span asp-validation-for="LinkedInUrl"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="XUrl" class="form-label"></label>

                <input asp-for="XUrl"
                       class="form-control"
                       placeholder="https://x.com/..." />

                <span asp-validation-for="XUrl"
                      class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            Kaydet
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Listeye Dön
        </a>
    </div>
</form>