<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - LifeSure Yönetim</title>

    <link rel="stylesheet"
          href="~/LifeSure-1.0.0/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />
</head>
<body>
    <a href="#adminContent" class="admin-skip-link">
        İçeriğe geç
    </a>

    <header class="admin-header">
        <div class="d-flex align-items-center gap-3">
            <button type="button"
                    class="btn btn-light d-lg-none"
                    data-bs-toggle="collapse"
                    data-bs-target="#adminSidebar"
                    aria-controls="adminSidebar"
                    aria-expanded="false"
                    aria-label="Yönetim menüsünü aç veya kapat">

                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>

            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="admin-brand">
                LifeSure
            </a>

            <span class="admin-header-label d-none d-md-inline">
                Yönetim Paneli
            </span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-sm btn-outline-primary">

                <i class="fas fa-external-link-alt me-1"
                   aria-hidden="true"></i>

                Siteyi Gör
            </a>

            <form asp-area="Admin"
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post"
                  class="m-0">

                <button type="submit"
                        class="btn btn-sm btn-outline-danger">

                    <i class="fas fa-sign-out-alt me-1"
                       aria-hidden="true"></i>

                    Çıkış
                </button>
            </form>
        </div>
    </header>

    <div class="admin-shell">
        <partial name="~/Areas/Admin/Views/Shared/_AdminSidebar.cshtml" />

        <main id="adminContent" class="admin-main" tabindex="-1">
            <div class="admin-page-heading">
                <div>
                    <p class="admin-eyebrow">LIFESURE YÖNETİM</p>
                    <h1>@ViewData["Title"]</h1>
                </div>

                <div class="admin-user">
                    <i class="fas fa-user-circle" aria-hidden="true"></i>
                    <span>@User.Identity?.Name</span>
                </div>
            </div>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show"
                     role="status">

                    @successMessage

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Kapat">
                    </button>
                </div>
            }

            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show"
                     role="alert">

                    @errorMessage

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Kapat">
                    </button>
                </div>
            }

            @RenderBody()

            <footer class="admin-footer">
                &copy; @DateTime.UtcNow.Year LifeSure
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>