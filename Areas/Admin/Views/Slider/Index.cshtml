@model List<LifeSure.CQRS.Sliders.Results.SliderResult>

@{
    ViewData["Title"] = "Slider Yönetimi";
}

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
        <h2 class="h5 mb-0">Slider Listesi</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1" aria-hidden="true"></i>
            Yeni Slider
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info mb-0">
            Henüz slider eklenmemiş.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Görsel</th>
                        <th>Başlık</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slider in Model)
                    {
                        var translation = slider.Translations
                            .FirstOrDefault(x => x.LanguageCode == "tr");

                        <tr>
                            <td>
                                <img src="@slider.ImageUrl"
                                     alt="@(translation?.Title ?? "Slider görseli")"
                                     width="100"
                                     height="65"
                                     class="rounded"
                                     style="object-fit: cover;" />
                            </td>

                            <td>@(translation?.Title ?? "Başlıksız")</td>

                            <td>@slider.DisplayOrder</td>

                            <td>
                                @if (slider.IsActive)
                                {
                                    <span class="badge bg-success">Yayında</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>

                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit"
                                       asp-route-id="@slider.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Düzenle
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@slider.Id"
                                          method="post"
                                          onsubmit="return confirm('Bu slider silinsin mi?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Sil
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>