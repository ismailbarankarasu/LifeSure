@using System.Globalization

@{
    var isEnglish = CultureInfo.CurrentUICulture
        .TwoLetterISOLanguageName == "en";

    var currentLanguage = isEnglish ? "English" : "Türkçe";

    var returnUrl =
        $"{Context.Request.PathBase}{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="dropdown lifesure-language-selector">
    <button type="button"
            class="btn btn-sm btn-outline-primary dropdown-toggle"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="@L["Language.Label"]">
        <i class="fas fa-globe me-1" aria-hidden="true"></i>
        @currentLanguage
    </button>

    <ul class="dropdown-menu dropdown-menu-end">
        <li>
            <form asp-area=""
                  asp-controller="Language"
                  asp-action="Change"
                  method="post">

                <input type="hidden" name="culture" value="tr-TR" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <button type="submit"
                        class="dropdown-item @(!isEnglish ? "active" : "")"
                        lang="tr">
                    Türkçe
                </button>
            </form>
        </li>

        <li>
            <form asp-area=""
                  asp-controller="Language"
                  asp-action="Change"
                  method="post">

                <input type="hidden" name="culture" value="en-US" />
                <input type="hidden" name="returnUrl" value="@returnUrl" />

                <button type="submit"
                        class="dropdown-item @(isEnglish ? "active" : "")"
                        lang="en">
                    English
                </button>
            </form>
        </li>
    </ul>
</div>