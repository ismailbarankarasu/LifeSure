@using System.Globalization
@model List<LifeSure.Mediator.TeamMembers.Results.TeamMemberResult>

@{
    var isEnglish = CultureInfo.CurrentUICulture
        .TwoLetterISOLanguageName == "en";

    var language = isEnglish ? "en" : "tr";
}

<section id="ekibimiz">
    @if (Model.Count > 0)
    {
        <div class="container-fluid py-5">
            <div class="container py-5">
                <div class="text-center mx-auto pb-5"
                     style="max-width: 800px;">
                    <h4 class="text-primary">
                        @L["Team.Subtitle"]
                    </h4>

                    <h2 class="display-4 mb-4">
                        @L["Team.Title"]
                    </h2>

                    <p class="mb-0">
                        @L["Team.Description"]
                    </p>
                </div>

                <div class="row g-4 justify-content-center">
                    @foreach (var member in Model)
                    {
                        var translation = member.Translations
                            .FirstOrDefault(x => x.LanguageCode == language)
                            ?? member.Translations
                                .FirstOrDefault(x => x.LanguageCode == "tr");

                        var socialLinks = new[]
                        {
                            new
                            {
                                Url = member.FacebookUrl,
                                Name = "Facebook",
                                Icon = "fab fa-facebook-f"
                            },
                            new
                            {
                                Url = member.InstagramUrl,
                                Name = "Instagram",
                                Icon = "fab fa-instagram"
                            },
                            new
                            {
                                Url = member.LinkedInUrl,
                                Name = "LinkedIn",
                                Icon = "fab fa-linkedin-in"
                            },
                            new
                            {
                                Url = member.XUrl,
                                Name = "X",
                                Icon = ""
                            }
                        };

                        <div class="col-sm-6 col-lg-4 col-xl-3">
                            <article class="lifesure-team-card">
                                <div class="lifesure-team-photo">
                                    <img src="@member.ImageUrl"
                                         alt="@member.FullName"
                                         loading="lazy" />
                                </div>

                                <div class="lifesure-team-info">
                                    <h3 class="h5 mb-2">
                                        @member.FullName
                                    </h3>

                                    <p class="text-muted mb-0">
                                        @translation?.JobTitle
                                    </p>

                                    @if (socialLinks.Any(x => !string.IsNullOrWhiteSpace(x.Url)))
                                    {
                                        <div class="lifesure-team-socials">
                                            @foreach (var social in socialLinks)
                                            {
                                                if (string.IsNullOrWhiteSpace(social.Url))
                                                {
                                                    continue;
                                                }

                                                <a href="@social.Url"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   aria-label="@($"{member.FullName} - {social.Name}")">
                                                    @if (social.Name == "X")
                                                    {
                                                        <span aria-hidden="true"
                                                              class="fw-bold">X</span>
                                                    }
                                                    else
                                                    {
                                                        <i class="@social.Icon"
                                                           aria-hidden="true"></i>
                                                    }
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</section>