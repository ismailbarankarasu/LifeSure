@model List<LifeSure.CQRS.Features.Results.FeatureResult>

@{
    var language = System.Globalization.CultureInfo
        .CurrentUICulture.TwoLetterISOLanguageName;

    language = language == "en" ? "en" : "tr";

}

<section id="ozellikler">
    @if (Model.Count > 0)
    {
        <div class="container-fluid feature bg-light py-5">
            <div class="container py-5">
                <div class="text-center mx-auto pb-5"
                     style="max-width: 800px;">

                    <h4 class="text-primary">
                        @L["Features.Subtitle"]
                    </h4>

                    <h2 class="display-4 mb-4">
                        @L["Features.Title"]
                    </h2>

                    <p class="mb-0">
                        @L["Features.Description"]
                    </p>
                </div>

                <div class="row g-4 justify-content-center">
                    @foreach (var feature in Model)
                    {
                        var translation = feature.Translations
                            .FirstOrDefault(x => x.LanguageCode == language)
                            ?? feature.Translations
                                .FirstOrDefault(x => x.LanguageCode == "tr");

                        if (translation is null)
                        {
                            continue;
                        }

                        <div class="col-12 col-md-6 col-xl-3">
                            <div class="feature-item p-4 pt-0 h-100">
                                <div class="feature-icon p-4 mb-4">
                                    <i class="@feature.IconClass fa-3x"
                                       aria-hidden="true"></i>
                                </div>

                                <h3 class="h4 mb-4">@translation.Title</h3>

                                <p class="mb-0">@translation.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</section>