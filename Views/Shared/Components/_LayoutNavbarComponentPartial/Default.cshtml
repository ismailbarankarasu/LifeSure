@inject LifeSure.Services.SiteSettings.ISiteSettingsReader SettingsReader

@{
    var siteSettings = await SettingsReader.GetAsync(
        Context.RequestAborted);

    var siteName = siteSettings?.SiteName ?? "LifeSure";
}
<div class="container-fluid nav-bar px-0 px-lg-4 py-lg-0">
    <div class="container">
        <nav class="navbar navbar-expand-lg navbar-light"
             aria-label="Ana menü">
            <a href="/#anasayfa" class="navbar-brand p-0">
                <h1 class="text-primary mb-0">
                    <i class="fas fa-star-of-life me-3" aria-hidden="true"></i>
                    @siteName
                </h1>
            </a>
        </a>

        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarCollapse"
                aria-controls="navbarCollapse"
                aria-expanded="false"
                aria-label="Menüyü aç veya kapat">
            <span class="fa fa-bars" aria-hidden="true"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarCollapse">
            <div class="navbar-nav ms-auto">
                <a href="/#anasayfa" class="nav-item nav-link active">
                    @L["Nav.Home"]
                </a>

                <a href="/#ozellikler" class="nav-item nav-link">
                    @L["Nav.Features"]
                </a>

                <a href="/#hakkimizda" class="nav-item nav-link">
                    @L["Nav.About"]
                </a>

                <a href="/#hizmetler" class="nav-item nav-link">
                    @L["Nav.Services"]
                </a>

                <a href="/#sss" class="nav-item nav-link">
                    @L["Nav.Faq"]
                </a>

                <a href="/#ekibimiz" class="nav-item nav-link">
                    @L["Nav.Team"]
                </a>

                <a href="/#referanslar" class="nav-item nav-link">
                    @L["Nav.Testimonials"]
                </a>

                <a href="/#iletisim" class="nav-item nav-link">
                    @L["Nav.Contact"]
                </a>
            </div>
        </div>

    </nav>
</div>
</div>