@using System.Globalization
@model List<LifeSure.CQRS.Statistics.Results.StatisticResult>

@{
    var language = CultureInfo.CurrentUICulture
        .TwoLetterISOLanguageName == "en" ? "en" : "tr";
}

@if (Model.Count > 0)
{
    <div class="row g-4 mt-4">
        @foreach (var item in Model)
        {
            var translation = item.Translations
                .FirstOrDefault(x => x.LanguageCode == language)
                ?? item.Translations
                    .FirstOrDefault(x => x.LanguageCode == "tr");

            if (translation is null)
            {
                continue;
            }

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="bg-white rounded h-100 p-4 text-center shadow-sm">
                    <div class="display-5 fw-bold text-primary mb-2">
                        @if (item.DisplayValue > 0)
                        {
                            <span data-toggle="counter-up">@item.DisplayValue</span>
                        }
                        else
                        {
                            <span>0</span>
                        }
                        @if (!string.IsNullOrEmpty(item.Suffix))
                        {
                            <span>@item.Suffix</span>
                        }
                    </div>

                    <p class="mb-0 fw-semibold">
                        @translation.Title
                    </p>
                </div>
            </div>
        }
    </div>
}