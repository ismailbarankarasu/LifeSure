@model LifeSure.Mediator.ContactMessages.Models.ContactMessageInput

<section id="iletisim">
    <div class="container-fluid bg-light py-5">
        <div class="container py-5">
            <div class="row g-5">
                <div class="col-lg-4">
                    <h4 class="text-primary">
                        @L["Nav.Contact"]
                    </h4>

                    <h2 class="display-5 mb-4">
                        @L["Contact.Title"]
                    </h2>

                    <p class="text-muted">
                        @L["Contact.Description"]
                    </p>
                </div>

                <div class="col-lg-8">
                    <div class="bg-white rounded p-4 p-lg-5 shadow-sm">
                        <form id="contactForm"
                              asp-area=""
                              asp-controller="Contact"
                              asp-action="Send"
                              method="post"
                              novalidate
                              data-success-message="@L["Contact.Success"]"
                              data-error-message="@L["Contact.Error"]"
                              data-limit-message="@L["Contact.RateLimit"]"
                              data-sending-message="@L["Contact.Sending"]">

                            <div id="contactFormFeedback"
                                 class="mb-4"
                                 role="status"
                                 aria-live="polite"
                                 tabindex="-1"
                                 hidden></div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="contactFullName" class="form-label">
                                        @L["Contact.FullName"]
                                    </label>

                                    <input asp-for="FullName"
                                           id="contactFullName"
                                           autocomplete="name"
                                           maxlength="150"
                                           required
                                           class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label for="contactEmail" class="form-label">
                                        @L["Contact.Email"]
                                    </label>

                                    <input asp-for="Email"
                                           id="contactEmail"
                                           type="email"
                                           autocomplete="email"
                                           maxlength="254"
                                           required
                                           class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label for="contactPhone" class="form-label">
                                        @L["Contact.PhoneOptional"]
                                    </label>

                                    <input asp-for="PhoneNumber"
                                           id="contactPhone"
                                           type="tel"
                                           autocomplete="tel"
                                           maxlength="30"
                                           class="form-control" />
                                </div>

                                <div class="col-md-6">
                                    <label for="contactSubject" class="form-label">
                                        @L["Contact.Subject"]
                                    </label>

                                    <input asp-for="Subject"
                                           id="contactSubject"
                                           maxlength="200"
                                           required
                                           class="form-control" />
                                </div>

                                <div class="col-12">
                                    <label for="contactMessage" class="form-label">
                                        @L["Contact.Message"]
                                    </label>

                                    <textarea asp-for="Message"
                                              id="contactMessage"
                                              rows="6"
                                              maxlength="6000"
                                              required
                                              class="form-control"></textarea>
                                </div>

                                <div class="col-12">
                                    <button type="submit"
                                            class="btn btn-primary rounded-pill px-4 py-3">
                                        @L["Contact.Send"]
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/js/contact-form.js"
        asp-append-version="true"
        defer></script>