@using System.Globalization
@model List<LifeSure.Mediator.Services.Results.ServiceResult>

@{
    var isEnglish = CultureInfo.CurrentUICulture
        .TwoLetterISOLanguageName == "en";

    var language = isEnglish ? "en" : "tr";
}

<section id="hizmetler">
    @if (Model.Count > 0)
    {
        <div class="container-fluid service py-5">
            <div class="container py-5">
                <div class="text-center mx-auto pb-5"
                     style="max-width: 800px;">
                    <h4 class="text-primary">
                        @(isEnglish ? "Our Services" : "Hizmetlerimiz")
                    </h4>

                    <h2 class="display-4 mb-4">
                        @(isEnglish
                            ? "Support for Every Stage of Life"
                            : "Hayatın Her Alanında Yanınızdayız")
                    </h2>

                    <p class="mb-0">
                        @(isEnglish
                            ? "Explore our services and find options for your needs."
                            : "Hizmetlerimizi keşfedin, ihtiyaçlarınıza uygun seçenekleri inceleyin.")
                    </p>
                </div>

                <div class="row g-4">
                    @foreach (var service in Model)
                    {
                        var translation = service.Translations
                            .FirstOrDefault(x => x.LanguageCode == language)
                            ?? service.Translations
                                .FirstOrDefault(x => x.LanguageCode == "tr");

                        if (translation is null)
                        {
                            continue;
                        }

                        <div class="col-md-6 col-xl-3">
                            <div class="service-item rounded h-100 d-flex flex-column">
                                <div class="service-img rounded-top position-relative">
                                    <img src="@service.ImageUrl"
                                         alt="@translation.Title"
                                         loading="lazy"
                                         class="img-fluid rounded-top w-100"
                                         style="height: 220px; object-fit: cover;" />

                                    <div class="service-icon p-3">
                                        <i class="@service.IconClass fa-2x"
                                           aria-hidden="true"></i>
                                    </div>
                                </div>

                                <div class="service-content rounded-bottom p-4 d-flex flex-column flex-grow-1">
                                    <h3 class="h4 mb-3">
                                        @translation.Title
                                    </h3>

                                    <p class="mb-4">
                                        @translation.ShortDescription
                                    </p>

                                    <button type="button"
                                            class="btn btn-primary rounded-pill py-2 px-4 mt-auto align-self-start"
                                            data-bs-toggle="modal"
                                            data-bs-target="#serviceDetailsModal"
                                            data-service-title="@translation.Title"
                                            data-service-description="@translation.Description">
                                        @(isEnglish ? "Read More" : "Devamını Oku")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="modal fade"
             id="serviceDetailsModal"
             tabindex="-1"
             aria-labelledby="serviceDetailsModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5"
                            id="serviceDetailsModalLabel">
                            @(isEnglish ? "Service Details" : "Hizmet Detayı")
                        </h2>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="@(isEnglish ? "Close" : "Kapat")">
                        </button>
                    </div>

                    <div class="modal-body">
                        <p id="serviceDetailsDescription"
                           class="mb-0"
                           style="white-space: pre-line; overflow-wrap: anywhere;"></p>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            @(isEnglish ? "Close" : "Kapat")
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script src="~/js/service-details.js"
                asp-append-version="true"
                defer></script>
    }
</section>