@using System.Globalization
@model LifeSure.CQRS.Abouts.Results.AboutResult

@{
    var language = CultureInfo.CurrentUICulture
        .TwoLetterISOLanguageName == "en" ? "en" : "tr";

    var translation = Model?.Translations
        .FirstOrDefault(x => x.LanguageCode == language)
        ?? Model?.Translations
            .FirstOrDefault(x => x.LanguageCode == "tr");
}

<section id="hakkimizda">
    @if (Model is not null && translation is not null)
    {
        <div class="container-fluid bg-light about py-5">
            <div class="container py-5">
                <div class="row g-5 align-items-center">
                    <div class="col-xl-6">
                        <div class="bg-white rounded p-4 p-lg-5">
                            <h4 class="text-primary">
                                @translation.Subtitle
                            </h4>

                            <h2 class="display-4 mb-4">
                                @translation.Title
                            </h2>

                            <p class="mb-0" style="white-space: pre-line;">@translation.Description</p>
                        </div>
                    </div>

                    <div class="col-xl-6">
                        <img src="@Model.ImageUrl"
                             alt="@translation.Title"
                             class="img-fluid rounded w-100" />
                    </div>
                </div>

                @await Component.InvokeAsync("_StatisticComponentPartial")
            </div>
        </div>
    }
</section>