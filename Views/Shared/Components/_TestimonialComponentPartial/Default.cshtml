@using System.Globalization
@model List<LifeSure.Mediator.Testimonials.Results.TestimonialResult>

@{
    var isEnglish = CultureInfo.CurrentUICulture
        .TwoLetterISOLanguageName == "en";

    var language = isEnglish ? "en" : "tr";
}

<section id="referanslar">
    @if (Model.Count > 0)
    {
        <div class="container-fluid bg-light py-5">
            <div class="container py-5">
                <div class="text-center mx-auto pb-5"
                     style="max-width: 800px;">
                    <h4 class="text-primary">
                        @L["Testimonials.Subtitle"]
                    </h4>

                    <h2 class="display-4 mb-4">
                        @L["Testimonials.Title"]
                    </h2>

                    <p class="mb-0">
                        @L["Testimonials.Description"]
                    </p>
                </div>

                <div class="row g-4 justify-content-center">
                    @foreach (var item in Model)
                    {
                        var translation = item.Translations
                            .FirstOrDefault(x => x.LanguageCode == language)
                            ?? item.Translations
                                .FirstOrDefault(x => x.LanguageCode == "tr");

                        if (translation is null)
                        {
                            continue;
                        }

                        var ratingLabel = L["Testimonials.RatingLabel", item.Rating].Value;

                        <div class="col-md-6 col-xl-4">
                            <figure class="lifesure-review-card">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="lifesure-review-stars"
                                         role="img"
                                         aria-label="@ratingLabel">
                                        @for (var star = 1; star <= 5; star++)
                                        {
                                            <i class="@(star <= item.Rating ? "fas" : "far") fa-star"
                                               aria-hidden="true"></i>
                                        }
                                    </div>

                                    <i class="fas fa-quote-right lifesure-review-quote"
                                       aria-hidden="true"></i>
                                </div>

                                <blockquote class="lifesure-review-comment">
                                    <p>@translation.Comment</p>
                                </blockquote>

                                <figcaption class="lifesure-review-person">
                                    <img src="@item.ImageUrl"
                                         alt=""
                                         loading="lazy" />

                                    <div>
                                        <h3 class="h6 mb-1">
                                            @item.FullName
                                        </h3>

                                        <span class="text-muted small">
                                            @translation.Title
                                        </span>
                                    </div>
                                </figcaption>
                            </figure>
                        </div>
                    }
                </div>

                <p class="small text-muted text-center mt-4 mb-0">
                    @L["Testimonials.DemoNote"]
                </p>
            </div>
        </div>
    }
</section>