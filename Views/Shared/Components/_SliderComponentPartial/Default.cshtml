@model List<LifeSure.CQRS.Sliders.Results.SliderResult>

@{
    var language = System.Globalization.CultureInfo
        .CurrentUICulture.TwoLetterISOLanguageName;

    language = language == "en" ? "en" : "tr";
}

@if (Model.Count > 0)
{
    <div id="anasayfa" class="header-carousel owl-carousel">
        @foreach (var slider in Model)
        {
            var translation = slider.Translations
                .FirstOrDefault(x => x.LanguageCode == language)
                ?? slider.Translations
                    .FirstOrDefault(x => x.LanguageCode == "tr");

            if (translation is null)
            {
                continue;
            }

            <div class="header-carousel-item bg-primary">
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row g-4 align-items-center">
                            <div class="col-lg-7">
                                <div class="text-center text-lg-start">
                                    <h4 class="text-white text-uppercase fw-bold mb-4">
                                        @translation.Subtitle
                                    </h4>

                                    <h2 class="display-1 text-white mb-4">
                                        @translation.Title
                                    </h2>

                                    <p class="mb-5 fs-5">
                                        @translation.Description
                                    </p>

                                    <div class="d-flex flex-wrap justify-content-center justify-content-lg-start gap-3">
                                        @if (!string.IsNullOrWhiteSpace(slider.VideoId))
                                        {
                                            <button type="button"
                                                    class="btn btn-light rounded-pill py-3 px-4"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#videoModal"
                                                    data-video-id="@slider.VideoId">

                                                <i class="fas fa-play-circle me-2"
                                                   aria-hidden="true"></i>

                                                Videoyu İzle
                                            </button>
                                        }

                                        <a href="@slider.ButtonUrl"
                                           class="btn btn-dark rounded-pill py-3 px-4">
                                            @translation.ButtonText
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-5">
                                <img src="@slider.ImageUrl"
                                     class="img-fluid w-100"
                                     alt="@translation.Title" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div id="anasayfa"></div>
}